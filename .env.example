# Copy to .env and adjust. All values have safe development defaults.

# HTTP port the server listens on
PORT=3000

# Secret used to sign JWT access tokens. MUST be changed in production.
JWT_SECRET=change-me-to-a-long-random-string

# How long an access token stays valid (seconds). Default: 7 days
JWT_TTL=604800

# Absolute or relative path to the SQLite database file
DATABASE_FILE=./data/menu.db

# Public base URL used when generating QR codes for tables.
# Must be reachable by the phone that scans the code.
PUBLIC_BASE_URL=http://localhost:3000
